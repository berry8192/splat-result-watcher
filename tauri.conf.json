{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "splat-result-watcher",
  "mainBinaryName": "splat-result-watcher-gui",
  "version": "0.1.0",
  "identifier": "com.berry8192.splat-result-watcher",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "splat-result-watcher",
        "width": 560,
        "height": 150,
        "minWidth": 200,
        "minHeight": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
